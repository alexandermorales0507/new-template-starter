# WebSerbisyo Public API Base URL (e.g. https://app.webserbisyo.com)
NEXT_PUBLIC_WEBSERBISYO_API_URL=

# Connected Event Slug (leave empty to enable generic demo mode)
NEXT_PUBLIC_EVENT_SLUG=

# Explicitly force design/demo mode ("true" or "false")
NEXT_PUBLIC_DESIGN_MODE=

# Custom Template Identifier
NEXT_PUBLIC_TEMPLATE_ID=wedding-custom-starter-v2
