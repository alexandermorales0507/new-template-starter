{
  "name": "webserbisyo-custom-wedding-starter-v2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:template": "tsx scripts/check-template-contract.ts",
    "verify": "npm run check:template && npm run typecheck && npm run format:check",
    "prebuild": "npm run verify",
    "verify:connection": "tsx scripts/verify-connection.ts"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "next": "^16.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2"
  }
}
